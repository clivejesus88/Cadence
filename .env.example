# =============================================================================
# Cadence — environment variables
# Copy this file to `.env` for local development.
# Vite only exposes variables prefixed with VITE_ to the browser bundle.
# =============================================================================

# --- Client (Vite / browser) -------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Web Push public key (VAPID). Generate a keypair once; keep the private key
# as an Edge Function secret only.
VITE_VAPID_PUBLIC_KEY=
# Sentry DSN for the browser client (optional but recommended).
VITE_SENTRY_DSN=
# RevenueCat Web Billing public SDK key (safe to expose in the browser).
VITE_REVENUECAT_WEB_API_KEY=

# --- Supabase Edge Functions (server / secrets) ------------------------------
# These are set with `supabase secrets set ...`, NOT in the browser .env.
# Listed here for reference.
#
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# SENTRY_DSN=
#
# --- Web Push (VAPID) ---
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
#
# --- Reminder cron ---
# CRON_SECRET=            # shared secret the cron job must send
#
# --- RevenueCat Web Billing ---
# Set in Supabase Edge Function secrets. Configure the same authorization
# value in the RevenueCat webhook dashboard.
# REVENUECAT_WEBHOOK_AUTHORIZATION=Bearer <random-secret>
# REVENUECAT_PRO_ENTITLEMENT_ID=pro
